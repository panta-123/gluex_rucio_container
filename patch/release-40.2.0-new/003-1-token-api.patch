+class RequestToken(ErrorHandlingMethodView):
+    """REST API endpoint to request an OIDC token."""
+
+    def post(self):
+        """
+        ---
+        summary: Request OIDC token
+        description: Request an OIDC token for a specific RSE and operation.
+        tags:
+          - Token
+        requestBody:
+          content:
+            'application/json':
+              schema:
+                type: object
+                required:
+                  - rse
+                  - operation
+                properties:
+                  rse:
+                    type: string
+                    description: "The RSE name."
+                  operation:
+                    type: string
+                    enum: ["download", "upload"]
+                    description: "The operation type."
+                  scope:
+                    type: string
+                    description: "The DID scope. Required when operation is 'upload'."
+                  name:
+                    type: string
+                    description: "The DID name. Required when operation is 'upload'."
+                  domain:
+                    type: string
+                    enum: ["wan", "lan"]
+                    default: "wan"
+                    description: "The network domain the token will be used over. Only used when operation is 'upload'."
+                  register_after_upload:
+                    type: boolean
+                    default: false
+                    description: "Whether the upload will use register-after-upload mode. Not supported for upload tokens; a request with true is rejected (400)."
+                  scheme:
+                    type: string
+                    description: "The scheme the client will write with (e.g. 'root', 'https'). Only used when operation is 'upload'; when omitted, all write protocols of the RSE are covered."
+                  no_register:
+                    type: boolean
+                    default: false
+                    description: "Whether the upload will use no-register mode. Only used when operation is 'upload'"
+        responses:
+          200:
+            description: "Token successfully generated"
+            content:
+              application/json:
+                schema:
+                  type: object
+                  properties:
+                    token:
+                      type: string
+          400:
+            description: "Invalid request or refused (bad/missing parameters, DID not a registered FILE, replica missing/elsewhere/not COPYING, no matching write protocol)."
+          401:
+            description: "Rucio authentication missing or invalid, or not permitted (no add_replicas permission on the RSE, or no_register not allowed)"
+          404:
+            description: "RSE not found"
+          503:
+            description: "The identity provider did not issue a token (retryable)"
+        """
+        parameters = json_parameters(parse_response)
+        rse = param_get(parameters, "rse")
+        operation = param_get(parameters, "operation")
+        scope = param_get(parameters, "scope", default=None)
+        name = param_get(parameters, "name", default=None)
+        domain = param_get(parameters, "domain", default="wan")
+        register_after_upload = param_get(parameters, "register_after_upload", default=False)
+        no_register = param_get(parameters, "no_register", default=False)
+        scheme = param_get(parameters, "scheme", default=None)
+
+        vo = request.environ.get("vo", DEFAULT_VO)
+        issuer = request.environ.get("issuer")
+
+        if operation == "upload" and (not scope or not name):
+            return generate_http_error_flask(
+                400, RucioException("'scope' and 'name' are required when operation is 'upload'")
+            )
+
+        try:
+            token = request_token(
+                rse=rse,
+                operation=operation,
+                vo=vo,
+                scope=scope,
+                name=name,
+                issuer=issuer,
+                domain=domain,
+                register_after_upload=register_after_upload,
+                no_register=no_register,
+                scheme=scheme,
+            )
+        except AccessDenied as error:
+            return generate_http_error_flask(401, error)
+        except RSENotFound as error:
+            return generate_http_error_flask(404, error)
+        except TokenMintError as error:
+            # Valid request, the IdP did not deliver: temporary from the client's view.
+            return generate_http_error_flask(503, error)
+        except RucioException as error:
+            return generate_http_error_flask(400, error)
+
+        return jsonify({"token": token}), 200
+
+
+def blueprint(with_doc=False):
+    bp = AuthenticatedBlueprint("tokens", __name__, url_prefix="/tokens")
+
+    request_token_view = RequestToken.as_view("request_token")
+    bp.add_url_rule("/request", view_func=request_token_view, methods=[HTTPMethod.POST.value])
+
+    bp.after_request(response_headers)
+    return bp
+
+
+def make_doc():
+    """Only used for sphinx documentation"""
+    from flask import Flask
+
+    doc_app = Flask(__name__)
+    doc_app.register_blueprint(blueprint(with_doc=True))
+    return doc_app
