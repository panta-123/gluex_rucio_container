@@ -108,3 +112,94 @@ class CredentialClient(BaseClient):
 
         exc_cls, exc_msg = self._get_exception(headers=r.headers, status_code=r.status_code, data=r.content)
         raise exc_cls(exc_msg)
+
+    def _post_token_request(self, data: dict[str, Any]) -> str:
+        """Send a sesson token request to the server and return the minted storage token."""
+        path = '/'.join([self.TOKEN_BASEURL, 'request'])
+        rurl = build_url(choice(self.list_hosts), path=path)
+        r = self._send_request(rurl, method=HTTPMethod.POST, data=json.dumps(data))
+        if r.status_code == codes.ok:
+            return json.loads(r.text)['token']
+        exc_cls, exc_msg = self._get_exception(headers=r.headers,
+                                            status_code=r.status_code,
+                                            data=r.content)
+        raise exc_cls(exc_msg)
+
+
+    def get_upload_token(
+        self,
+        rse: str,
+        scope: str,
+        name: str,
+        domain: Literal["wan", "lan"] = "wan",
+        register_after_upload: bool = False,
+        no_register: bool = False,
+    ) -> str:
+        """
+        Request a file-scoped OIDC token for uploading a single DID to an RSE.
+
+        The token authorizes writing exactly the ``scope:name`` DID on ``rse``.
+        Call it only after the DID is registered — the server refuses tokens for
+        unregistered DIDs.
+
+        Parameters
+        ----------
+        rse
+            The name of the RSE to upload to.
+        scope
+            DID scope of the file to upload.
+        name
+            DID name of the file to upload.
+        domain
+            Network domain the token applies to: ``"wan"`` or ``"lan"``.
+            Defaults to ``"wan"``.
+        register_after_upload
+            Whether the file is registered after the upload completes.
+            Defaults to ``False``.
+        no_register
+            Whether to skip registration entirely. Defaults to ``False``.
+
+        Returns
+        -------
+        str
+            The OIDC access token, valid until it expires.
+
+        Raises
+        ------
+        RucioException
+            If the server returns a status code other than ``200 OK``,
+            including when the DID is not yet registered.
+        """
+        return self._post_token_request({
+            'rse': rse,
+            'operation': 'upload',
+            'scope': scope,
+            'name': name,
+            'domain': domain,
+            'register_after_upload': register_after_upload,
+            'no_register': no_register,
+        })
+
+    def get_download_token(self, rse: str) -> str:
+        """
+        Request an RSE-scoped OIDC token for downloading from an RSE.
+
+        The token authorises reading from ``rse`` and is not tied to a specific
+        DID, so a single token can serve many files on that RSE.
+
+        Parameters
+        ----------
+        rse
+            The name of the RSE to download from.
+
+        Returns
+        -------
+        str
+            The OIDC access token, valid until it expires.
+
+        Raises
+        ------
+        RucioException
+            If the server returns a status code other than ``200 OK``.
+        """
+        return self._post_token_request({'rse': rse, 'operation': 'download'})
