         """
@@ -205,7 +214,6 @@ class ExternalPostgresJSONDidMeta(DidMetaPlugin):
             with conn.cursor() as cursor:
                 cursor.execute(statement)
                 metadata = cursor.fetchone()
-            conn.commit()

